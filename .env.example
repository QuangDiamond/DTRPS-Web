# Sao chép thành .env.local rồi chỉnh theo môi trường

# Địa chỉ gốc của REST API backend
VITE_API_URL=http://localhost:8080/api

# true (mặc định): chạy hoàn toàn bằng dữ liệu mẫu trong trình duyệt
# false: mọi service gọi API thật tại VITE_API_URL (xem src/services/endpoints.ts)
VITE_USE_MOCK=true

# Phân hệ đã có API thật — vẫn gọi backend kể cả khi VITE_USE_MOCK=true
# auth: đăng nhập admin thật (cần backend + tài khoản ADMIN); partners: Quản lý đối tác; listings: Duyệt địa điểm & bản sửa
VITE_LIVE_MODULES=auth,partners,listings

# Goong Maps (https://account.goong.io) — Maptiles key cho nền bản đồ (luôn công khai trong trình duyệt).
# API key (tìm địa chỉ, chỉ đường) đặt ở backend: GOONG_API_KEY — không đưa vào web
VITE_GOONG_MAPTILES_KEY=
