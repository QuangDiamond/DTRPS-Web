# Sao chép thành .env.local rồi chỉnh theo môi trường

# Địa chỉ gốc của REST API backend
VITE_API_URL=http://localhost:8080/api

# true (mặc định): chạy hoàn toàn bằng dữ liệu mẫu trong trình duyệt
# false: mọi service gọi API thật tại VITE_API_URL (xem src/services/endpoints.ts)
VITE_USE_MOCK=true
